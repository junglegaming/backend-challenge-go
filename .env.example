# Local example values only. No real secrets.

# Service
# INSTANCE_ID identifies the process (outbox lease owner, "instance" log
# attribute); it defaults to the hostname. The compose file sets app-1..3.
#INSTANCE_ID=app-1
LOG_LEVEL=info
HTTP_ADDR=:8080
STARTUP_TIMEOUT=25s
SHUTDOWN_TIMEOUT=61s
READY_TIMEOUT=2s
CONFLICT_RETRIES=5

# PostgreSQL
# The service connects as the least-privilege runtime login (member of the
# wallet_app group; created by deploy/postgres/init). "migrate" must run as
# the schema owner instead:
#   DATABASE_URL=postgres://wallet:wallet@localhost:5432/wallet?sslmode=disable
DATABASE_URL=postgres://wallet_service:wallet_service@localhost:5432/wallet?sslmode=disable
DB_MAX_CONNS=20
DB_LOCK_TIMEOUT=5s
DB_STATEMENT_TIMEOUT=10s

# OAuth 2.0 / OIDC (Keycloak)
OIDC_ISSUER=http://localhost:8180/realms/wallet
OIDC_JWKS_URL=http://localhost:8180/realms/wallet/protocol/openid-connect/certs
OIDC_AUDIENCE=wallet-api

# AWS SQS (LocalStack). Credentials are the LocalStack defaults.
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_INPUT_QUEUE=wager-transactions.fifo
SQS_DLQ=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wallet-events.fifo
SQS_CONSUMER_NAME=wager-transactions-consumer
SQS_CONSUMERS=2
SQS_MAX_MESSAGES=10
SQS_WAIT_TIME=10s
SQS_VISIBILITY_TIMEOUT=5m
SQS_PROCESS_TIMEOUT=20s
# Broker follow-up budget per message (delete, retry visibility, DLQ copy).
# SQS_VISIBILITY_TIMEOUT must exceed
# SQS_MAX_MESSAGES * (SQS_PROCESS_TIMEOUT + SQS_ACK_TIMEOUT).
SQS_ACK_TIMEOUT=5s
SQS_RETRY_BASE=2s
SQS_RETRY_MAX=60s
SQS_MAX_RECEIVE_COUNT=5
# SQS SenderId -> providers it may act for ("id=provider-a|provider-b;otherId=*").
# LocalStack reports every sender as the account id 000000000000.
SQS_SENDER_PROVIDERS=000000000000=*

# Pending references
PENDING_INTERVAL=1s
PENDING_BASE_DELAY=1s
PENDING_MAX_DELAY=60s
PENDING_MAX_ATTEMPTS=10
PENDING_BATCH=50

# Outbox relay
OUTBOX_INTERVAL=500ms
OUTBOX_BATCH=50
OUTBOX_LEASE=30s
OUTBOX_RETRY_BASE=1s
OUTBOX_RETRY_MAX=60s
# Broker publication has its own budget. Attempt accounting and the terminal
# durable mutation share the finalization budget; P + F must fit the lease.
OUTBOX_PUBLISH_TIMEOUT=10s
OUTBOX_FINALIZE_TIMEOUT=5s
# Failed publications before an event is dead-lettered (dead_lettered_at).
# Only explicit permanent payload errors exhaust this limit; transient errors keep retrying.
OUTBOX_MAX_ATTEMPTS=20
